# Araf frontend multi-stage Docker build.
# Build argument APP sets which console to build (tenant-console or operator-console).
ARG APP=tenant-console

FROM node:22-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS builder-common
WORKDIR /build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/api-client ./packages/api-client
COPY packages/fixtures ./packages/fixtures
COPY packages/i18n ./packages/i18n
COPY packages/schema-runtime ./packages/schema-runtime
COPY packages/ui ./packages/ui
COPY packages/shell ./packages/shell
COPY packages/resources ./packages/resources
COPY packages/operations ./packages/operations
COPY packages/governance ./packages/governance
COPY packages/operator-platform ./packages/operator-platform
COPY apps/tenant-console ./apps/tenant-console
COPY apps/operator-console ./apps/operator-console

# The bundle talks to the BFF same-origin (/api/...); nginx proxies /api/ to
# the BFF service selected by the BFF_UPSTREAM container env var. This keeps
# the deployment working from any host, not just localhost.
FROM builder-common AS builder
ARG APP
# Keep the image build toolchain aligned with the repository lockfile and CI.
RUN npm install -g pnpm@10.14.0 && pnpm install --frozen-lockfile && pnpm -F @araf/$APP build

# The unprivileged image listens on 8080 and runs nginx as uid 101. Keeping
# the static console outside the root account is part of the release gate.
FROM nginxinc/nginx-unprivileged:mainline-alpine-slim@sha256:dcc9bf9c084901dddbbce305130a7295c5637b6a8fce3e29cf678d86336982e4 AS runtime
ARG APP
ARG ARAF_VERSION=0.0.0-dev
ARG ARAF_GIT_SHA=unknown
LABEL org.opencontainers.image.title="Araf ${APP} console" \
      org.opencontainers.image.version="$ARAF_VERSION" \
      org.opencontainers.image.revision="$ARAF_GIT_SHA" \
      org.opencontainers.image.source="https://github.com/o3kio/araf"
COPY --from=builder /build/apps/$APP/dist /usr/share/nginx/html
COPY deploy/nginx-default.conf.template /etc/nginx/templates/default.conf.template
# The upstream is deployment configuration, not an image default.  The
# nginx entrypoint substitutes BFF_UPSTREAM at runtime; an unset value causes
# nginx validation to fail closed rather than silently targeting a developer
# endpoint.
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
