# Araf frontend multi-stage Docker build.
# Build argument APP sets which console to build (tenant-console or operator-console).
ARG APP=tenant-console

FROM node:22-slim AS builder-common
WORKDIR /build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/api-client ./packages/api-client
COPY packages/fixtures ./packages/fixtures
COPY packages/i18n ./packages/i18n
COPY packages/schema-runtime ./packages/schema-runtime
COPY packages/ui ./packages/ui
COPY packages/shell ./packages/shell
COPY packages/resources ./packages/resources
COPY packages/operations ./packages/operations
COPY packages/governance ./packages/governance
COPY packages/operator-platform ./packages/operator-platform
COPY apps/tenant-console ./apps/tenant-console
COPY apps/operator-console ./apps/operator-console

FROM builder-common AS builder
ARG APP
ARG VITE_TENANT_BFF_URL=http://localhost:8080
ARG VITE_OPERATOR_BFF_URL=http://localhost:8081
ENV VITE_TENANT_BFF_URL=$VITE_TENANT_BFF_URL
ENV VITE_OPERATOR_BFF_URL=$VITE_OPERATOR_BFF_URL
RUN npm install -g pnpm && pnpm install --frozen-lockfile && pnpm -F @araf/$APP build

FROM nginx:stable-alpine AS runtime
ARG APP
COPY --from=builder /build/apps/$APP/dist /usr/share/nginx/html
COPY deploy/nginx-default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
